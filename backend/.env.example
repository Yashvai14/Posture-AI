# Copy to .env and fill in real values. Never commit .env.

# Required ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
# PostgreSQL with the PostGIS and btree_gist extensions available (only PostgreSQL is supported).
DATABASE_URL=postgresql://postureai:postureai@localhost:5432/postureai

# Optional (defaults shown) ----------------------------------------------
# ENVIRONMENT=development            # development | test | production (production logs JSON)
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:3000 # comma-separated
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# RATE_LIMIT_ENABLED=true

# STORAGE_DIR=./storage              # private files; never serve this directory directly
# MAX_UPLOAD_MB=10
# POSE_MODEL_PATH=./models/pose_landmarker_full.task

# JOB_MODE=thread                    # thread (background) | inline (tests)
# JOB_WORKERS=2

# OLLAMA_ENABLED=true
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_TIMEOUT_SECONDS=90
# OLLAMA_MAX_RETRIES=1

# PROVIDER_DISCOVERY_ENABLED=true
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# HTTP_USER_AGENT=PostureAI/2.0 (posture screening app; contact: you@example.com)   # identify yourself to OSM services
# PROVIDER_CACHE_DAYS=7
# DEFAULT_SEARCH_RADIUS_KM=30
# MAX_SEARCH_RADIUS_KM=50
# DEFAULT_TIMEZONE=Asia/Kolkata

# BOOKING_WINDOW_DAYS=60
# BOOKING_MIN_LEAD_MINUTES=30
